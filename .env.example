# Copy to .env on the server and fill in:  cp .env.example .env && chmod 600 .env
# .env holds secrets: never commit it (it is in .gitignore).
# Most Open WebUI values are only read on the FIRST start; see README.md.

# --- Open WebUI -------------------------------------------------------------
# Pin a release; check https://github.com/open-webui/open-webui/releases before changing.
OPEN_WEBUI_TAG=v0.12.5
# Generate with:  openssl rand -hex 32
WEBUI_SECRET_KEY=
# The HTTPS address `tailscale serve` gives this machine.
WEBUI_URL=https://homeserver.<your-tailnet>.ts.net
# Local port Open WebUI listens on (127.0.0.1 only).
OWUI_PORT=3000
# OWUI_MEM_LIMIT=4g
# JWT_EXPIRES_IN=4w

# Model connections, separated by ";" (same order in both lines).
# Venice only:
OPENAI_API_BASE_URLS=https://api.venice.ai/api/v1
OPENAI_API_KEYS=<venice-api-key>
# Venice + Runpod GPU Pod (port 8000 exposed on the Pod; the URL changes if the Pod is migrated):
# OPENAI_API_BASE_URLS=https://api.venice.ai/api/v1;https://<pod-id>-8000.proxy.runpod.net/v1
# OPENAI_API_KEYS=<venice-api-key>;<llama-api-key>

# --- Seedream image proxy ---------------------------------------------------
# BytePlus ModelArk key. Used when Open WebUI's image "API Key" field says "default".
ARK_API_KEY=
# Same value as the Pod's LLAMA_API_KEY, so the proxy never forwards it to BytePlus.
LLAMA_API_KEY=
# Optional (empty = proxy default):
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDREAM_MODEL=dola-seedream-5-0-pro-260628
# SEEDREAM_WATERMARK=false
# GEN_DEFAULT_SIZE=1K
# EDIT_SIZE_MODE=original
# UPSTREAM_TIMEOUT=300
# UPSTREAM_RETRIES=1
# ARK_KEY_HOSTS=.bytepluses.com
